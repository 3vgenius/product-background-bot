# --- Telegram ---------------------------------------------------------------
# From @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=1234567890:AA...

# Shared secret for the webhook. Any random long string; Telegram echoes it back
# in X-Telegram-Bot-Api-Secret-Token so forged POSTs to /webhook are rejected.
# On Render, `generateValue: true` in render.yaml creates this for you.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Comma-separated numeric Telegram IDs allowed to use the bot.
# Get yours from @userinfobot. Empty list = nobody can use the bot.
ALLOWED_USER_IDS=111111111,222222222

# --- GitHub -----------------------------------------------------------------
# Classic PAT with `repo` + `workflow` scopes. `repo` writes backgrounds and
# settings through the Contents API; `workflow` triggers the process workflow.
GITHUB_TOKEN=ghp_...
GITHUB_REPO=3vgenius/product-background-bot
GITHUB_BRANCH=main
WORKFLOW_FILE=process.yml

# --- Behaviour --------------------------------------------------------------
# webhook | polling | off
#   webhook  - Render (needs RENDER_EXTERNAL_URL, set automatically there)
#   polling  - local development, no public URL needed
#   off      - serve HTTP only (tests, health checks)
BOT_MODE=polling

# Local checkout root used when GITHUB_TOKEN is absent (local dev, tests).
REPO_DIR=.

# --- Image processing -------------------------------------------------------
OUTPUT_SIZE=1024
OBJECT_FILL=0.8
JPEG_QUALITY=95

# Model presets behind the "Быстро / Качество" button.
# Do NOT leave these unset expecting rembg's default: rembg now defaults to
# `bria-rmbg`, whose weights need a paid agreement for commercial use.
MODEL_FAST=isnet-general-use
MODEL_QUALITY=birefnet-general
DEFAULT_MODEL=isnet-general-use
